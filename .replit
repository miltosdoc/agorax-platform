modules = ["nodejs-20", "postgresql-16"]
[userenv]

[userenv.shared]
PORT = "5000"
NODE_ENV = "development"
VOTING_BACKEND = "hash-chain"
LOG_LEVEL = "info"
SIGNING_MASTER_KEY = "<redacted-signing-master-key>"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[nix]
channel = "stable-25_05"

[[ports]]
localPort = 5000
externalPort = 80
