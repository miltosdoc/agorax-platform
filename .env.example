# AgoraX Environment Variables

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/agorax

# Server
PORT=3000
NODE_ENV=development

# Voting backend: 'hash-chain' (default) or 'electionguard' (dev/demo only).
# EG_GUARDIANS / EG_THRESHOLD configure the trustee quorum (default 1-of-1).
VOTING_BACKEND=hash-chain
# EG_GUARDIANS=5
# EG_THRESHOLD=3

# Frontend
VITE_API_URL=http://localhost:3000

# Redis (optional, for caching)
REDIS_URL=redis://localhost:6379

# Email (optional, for notifications)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-password

# LLM API (optional, for proposal validation)
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key

# Ballot Service (Python FastAPI)
BALLOT_SERVICE_URL=http://localhost:8000

# Logging
LOG_LEVEL=info

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# LiveKit (optional, real-time community + sortition conference rooms).
# When any of the three is missing, all /api/livekit/* endpoints return
# 503 and the UI hides the conference surface. See docs/livekit-setup.md.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# LiveKit (video rooms) — απαιτούνται από το docker-compose.
# Δημιούργησε καθένα με: openssl rand -hex 32
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# ─── Security headers ───
# CSP ships in Report-Only mode. Watch the reports, then set CSP_ENFORCE=true.
CSP_ENFORCE=false
# Optional: endpoint that collects CSP violation reports.
# CSP_REPORT_URI=https://example.report-uri.com/r/d/csp/reportOnly
# Optional: extra origins the browser may connect to (comma-separated),
# e.g. a Sentry ingest host. LIVEKIT_URL is added automatically.
# CSP_CONNECT_SRC_EXTRA=

# Reject passwords found in known breach corpora (Have I Been Pwned range API,
# k-anonymity — the password never leaves this server). Set to false for
# deployments that must make no outbound calls.
PASSWORD_BREACH_CHECK=true
