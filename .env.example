# AgoraX Environment Variables

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/agorax

# Server
PORT=3000
NODE_ENV=development

# Voting backend: 'hash-chain' (default) or 'electionguard' (dev/demo only).
# EG_GUARDIANS / EG_THRESHOLD configure the trustee quorum (default 1-of-1).
VOTING_BACKEND=hash-chain
# EG_GUARDIANS=5
# EG_THRESHOLD=3

# Frontend
VITE_API_URL=http://localhost:3000

# Redis (optional, for caching)
REDIS_URL=redis://localhost:6379

# Email — Scaleway Transactional Email (smtp.tem.scaleway.com).
# Optional: with SMTP_HOST / SMTP_USER / SMTP_PASS unset, every send is a
# silent no-op and AgoraX runs exactly as before — no password-reset mail,
# no notification mail, in-app notifications unaffected.
#
# SMTP_USER is the Scaleway project ID, SMTP_PASS a Scaleway secret key.
# Never commit real values; set them in the deployment's own .env.
SMTP_HOST=smtp.tem.scaleway.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=<SCW_PROJECT_ID>
SMTP_PASS=<SCW_SECRET_KEY>
MAIL_FROM="AgoraX <no-reply@mail.agoraxdemocracy.com>"

# Absolute base for every link inside an email. Mail links are never built
# from a request Host header, so this must be set correctly in production.
APP_PUBLIC_URL=https://agoraxdemocracy.com

# Optional NOTIFICATION email (new proposals, votes, proposal updates).
# Off unless this is exactly "true", even with SMTP configured above.
#
# Deliberately a second switch. The phase sweeps run on a timer over
# proposals that are already in flight, so the first tick after enabling
# mail emits one message per member per live proposal — a whole community's
# inbox, in the first five seconds. Turn SMTP on first, confirm password
# reset and address confirmation work, look at how many members × how many
# live proposals that would be, then set this.
EMAIL_NOTIFICATIONS_ENABLED=false

# LLM API (optional, for proposal validation)
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key

# Ballot Service (Python FastAPI)
BALLOT_SERVICE_URL=http://localhost:8000

# Logging
LOG_LEVEL=info

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# LiveKit (optional, real-time community + sortition conference rooms).
# When any of the three is missing, all /api/livekit/* endpoints return
# 503 and the UI hides the conference surface. See docs/livekit-setup.md.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
